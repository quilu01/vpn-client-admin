# App
APP_NAME="VPN Client Admin"
APP_SECRET_KEY="replace-with-a-long-random-secret"
PUBLIC_APP_URL="https://vpn-admin.example.com"
POSTGRES_DB="vpn_admin"
POSTGRES_USER="vpn_admin"
POSTGRES_PASSWORD="replace-with-long-random-db-password"
DATABASE_URL="postgresql+psycopg://vpn_admin:replace-with-long-random-db-password@postgres:5432/vpn_admin"
APP_BIND_HOST="127.0.0.1"
APP_PORT="8000"

# Admin auth
ADMIN_USERNAME="admin"
# Generate with: python -m app.core.security hash-password
ADMIN_PASSWORD_HASH=""
# Development fallback only. Prefer ADMIN_PASSWORD_HASH in production.
ADMIN_PASSWORD="change-me"
ADMIN_IP_ALLOWLIST="127.0.0.1/32,::1/128"
TRUST_PROXY_HEADERS="false"
COOKIE_SECURE="true"

# 3x-ui
XUI_BASE_URL="https://xui.example.com"
XUI_API_TOKEN="replace-with-3x-ui-api-token"
XUI_INBOUND_ID="1"
XUI_INBOUNDS="1:Default"
XUI_SUBSCRIPTION_BASE_URL="https://xui.example.com/sub"
XUI_CLIENT_FLOW=""
XUI_TLS_VERIFY="true"

# Happ
HAPP_CRYPTO_API_URL="https://crypto.happ.su/api-v2.php"
# Use "passthrough" only for local development without Happ API access.
HAPP_CRYPTO_MODE="api"
HAPP_PROFILE_TITLE="VPN"
HAPP_SUPPORT_URL="https://t.me/kmplzzz"
HAPP_PROFILE_WEB_PAGE_URL="https://t.me/kmplzzz"
